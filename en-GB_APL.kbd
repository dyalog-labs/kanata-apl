;; English (UK) keyboard mappings for APL
;; en-GB_APL-v2.1
;; Compositions live in altgruk-compose.kbd and apl-numpad-box.kbd,
;; both included at the bottom.

;; ---------------------------------------------------------------------------
;; Shifting keys
;; ---------------------------------------------------------------------------

;; Choose one APL shifting key. Its default behaviour is produced by double-tapping.
(defvar apl caps)

;; Choose the composition ("dead key") shifting key.
(defvar dia ralt)

;; Choose more APL shifting keys by mapping them to @apl-mode in the base layer
(deflayermap base
  $apl   @apl-mode
  rctrl  @apl-mode
  $dia   @dia-mode
  lsft   @shift
  rsft   @rshift
)

;; With this layer, the order of APL+Shift or Shift+APL does not matter.
(deflayermap shift
  $apl  @apl-shift
  rctrl @apl-shift
)

;; ---------------------------------------------------------------------------
;; APL glyphs
;; ---------------------------------------------------------------------------

(deflayermap APL
  lsft @apl-shift
  rsft @apl-shift
  (t! numpad-box)      ;; box drawing on the keypad, from apl-numpad-box.kbd
  Backquote     (unicode ⋄)
  1             (unicode ¨)
  2             (unicode ¯)
  3             (unicode <)
  4             (unicode ≤)
  5             (unicode =)
  6             (unicode ≥)
  7             (unicode >)
  8             (unicode ≠)
  9             (unicode ∨)
  0             (unicode ∧)
  -             (unicode ×)
  =             (unicode ÷)
  q             (unicode ?)
  w             (unicode ⍵)
  e             (unicode ∊)
  r             (unicode ⍴)
  t             (unicode ~)
  y             (unicode ↑)
  u             (unicode ↓)
  i             (unicode ⍳)
  o             (unicode ○)
  p             (unicode *)
  [             (unicode ←)
  ]             (unicode →)
  a             (unicode ⍺)
  s             (unicode ⌈)
  d             (unicode ⌊)
  f             (unicode _)
  g             (unicode ∇)
  h             (unicode ∆)
  j             (unicode ∘)
  k             (unicode ')
  l             (unicode ⎕)
  ;             (unicode ⍎)
  '             (unicode ⍕)
  IntlBackslash (unicode ⊢)
  z             (unicode ⊂)
  x             (unicode ⊃)
  c             (unicode ∩)
  v             (unicode ∪)
  b             (unicode ⊥)
  n             (unicode ⊤)
  m             (unicode |)
  ,             (unicode ⍝)
  .             (unicode ⍀)
  /             (unicode ⌿)
)

(deflayermap APL-shift
  Backquote     (unicode ⌺)
  1             (unicode ⌶)
  2             (unicode ⍫)
  3             (unicode ⍒)
  4             (unicode ⍋)
  5             (unicode ⌽)
  6             (unicode ⍉)
  7             (unicode ⊖)
  8             (unicode ⍟)
  9             (unicode ⍱)
  0             (unicode ⍲)
  -             (unicode !)
  =             (unicode ⌹)
  e             (unicode ⍷)
  t             (unicode ⍨)
  i             (unicode ⍸)
  o             (unicode ⍥)
  p             (unicode ⍣)
  [             (unicode ⍞)
  ]             (unicode ⍬)
  f             (unicode ⍛)
  g             (unicode ⍢)
  j             (unicode ⍤)
  k             (unicode ⌸)
  l             (unicode ⌷)
  ;             (unicode ≡)
  '             (unicode ≢)
  IntlBackslash (unicode ⊣)
  z             (unicode ⊆)
  x             (unicode ⊇)
  n             (unicode ¤)
  m             (unicode ∥)
  ,             (unicode ⍪)
  .             (unicode ⍙)
  /             (unicode ⍠)
)

;; ---------------------------------------------------------------------------
;; Aliases
;; ---------------------------------------------------------------------------

(defalias apl-mode   ;; Double-tap prefix key to output its symbol
  (tap-dance 200 (
    (layer-while-held APL)
    _
  ))
)

(defalias shift     (multi lsft (layer-while-held shift)))
(defalias rshift    (multi rsft (layer-while-held shift)))
(defalias apl-shift (layer-while-held APL-shift))

(include altgruk-compose.kbd)
(include apl-numpad-box.kbd)

(defsrc)
(defcfg
  process-unmapped-keys yes
  windows-altgr add-lctl-release
  windows-sync-keystates none
)
